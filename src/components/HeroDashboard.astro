---
/**
 * 메인 히어로: 파티클 카운터 허브 "구성 예시 화면".
 * - 업종 탭(반도체·제약 GMP·디스플레이·식품)마다 구역·등급·채널이 바뀐다.
 * - 값은 운전 중 전형적 수준이며 몇 초마다 흔들리고, 주기적으로 한 구역에서 "출입 감지 → 주의 → 회복" 이벤트가 연출된다.
 * - 실제 현장 데이터가 아니며 화면에 "구성 예시"로 표시한다.
 * vals: [크기 표기, 값, 한계(개/m³)]. 한계 0 = 표준에 한계 없음(판정 제외). event: 이벤트가 일어나는 구역 번호.
 */
const presets = [
  { id: 'semi', label: '반도체', title: 'FAB 2층', event: 2, zones: [
    { zone: '포토 Bay 1', dev: 'LPC-07', cls: 'ISO 4', vals: [['0.1 µm', 2300, 10000], ['0.3 µm', 210, 1020], ['0.5 µm', 48, 352]] },
    { zone: '식각 Bay 3', dev: 'LPC-12', cls: 'ISO 5', vals: [['0.1 µm', 18500, 100000], ['0.3 µm', 1460, 10200], ['0.5 µm', 360, 3520]] },
    { zone: '세정 Wet Bay 2', dev: 'LPC-18', cls: 'ISO 5', vals: [['0.1 µm', 34000, 100000], ['0.3 µm', 2900, 10200], ['0.5 µm', 720, 3520]] },
    { zone: 'CMP 구역', dev: 'LPC-24', cls: 'ISO 6', vals: [['0.1 µm', 164000, 1000000], ['0.3 µm', 12400, 102000], ['0.5 µm', 3900, 35200]] },
  ] },
  { id: 'pharma', label: '제약 GMP', title: '무균 제제동', event: 1, zones: [
    { zone: '충전실', dev: 'LPC-21', cls: 'Grade A', vals: [['0.5 µm', 35, 3520], ['1.0 µm', 6, 832], ['5.0 µm', 0, 0]] },
    { zone: '충전실 배경', dev: 'LPC-22', cls: 'Grade B', vals: [['0.5 µm', 48000, 352000], ['1.0 µm', 11000, 83200], ['5.0 µm', 320, 2930]] },
    { zone: '조제실', dev: 'LPC-25', cls: 'Grade C', vals: [['0.5 µm', 610000, 3520000], ['1.0 µm', 140000, 832000], ['5.0 µm', 4100, 29300]] },
    { zone: '세척·멸균 준비실', dev: 'LPC-28', cls: 'Grade D', vals: [['0.5 µm', 980000, 3520000], ['1.0 µm', 210000, 832000], ['5.0 µm', 7900, 29300]] },
  ] },
  { id: 'display', label: '디스플레이', title: 'OLED 라인', event: 2, zones: [
    { zone: '증착 챔버 전실', dev: 'LPC-31', cls: 'ISO 4', vals: [['0.1 µm', 1900, 10000], ['0.3 µm', 170, 1020], ['0.5 µm', 40, 352]] },
    { zone: '포토 라인', dev: 'LPC-34', cls: 'ISO 5', vals: [['0.1 µm', 28000, 100000], ['0.3 µm', 2100, 10200], ['0.5 µm', 520, 3520]] },
    { zone: '셀 조립', dev: 'LPC-37', cls: 'ISO 6', vals: [['0.1 µm', 150000, 1000000], ['0.3 µm', 11000, 102000], ['0.5 µm', 3400, 35200]] },
    { zone: '모듈 검사', dev: 'LPC-39', cls: 'ISO 7', vals: [['0.5 µm', 120000, 352000], ['1.0 µm', 28000, 83200], ['5.0 µm', 900, 2930]] },
  ] },
  { id: 'food', label: '식품', title: 'HACCP 포장동', event: 0, zones: [
    { zone: '충전·포장실', dev: 'LPC-41', cls: 'ISO 7', vals: [['0.5 µm', 150000, 352000], ['1.0 µm', 36000, 83200], ['5.0 µm', 1100, 2930]] },
    { zone: '가열 후 냉각실', dev: 'LPC-43', cls: 'ISO 8', vals: [['0.5 µm', 820000, 3520000], ['1.0 µm', 190000, 832000], ['5.0 µm', 6200, 29300]] },
    { zone: '원료 전처리', dev: 'LPC-45', cls: 'ISO 8', vals: [['0.5 µm', 1450000, 3520000], ['1.0 µm', 330000, 832000], ['5.0 µm', 12000, 29300]] },
    { zone: '창고 연결 복도', dev: 'LPC-48', cls: 'ISO 9', vals: [['0.5 µm', 4200000, 35200000], ['1.0 µm', 980000, 8320000], ['5.0 µm', 41000, 293000]] },
  ] },
];
const LABEL = { ok: '정상', warn: '주의', alarm: '경보' };
const fmt = (n: number) => n.toLocaleString('ko-KR');
const first = presets[0];
---

<div class="hd-wrap">
  <div class="hd" aria-label="파티클 카운터 허브 구성 예시 화면">
    <div class="hd-head">
      <span class="hd-live"><i></i>DEMO</span>
      <span class="hd-title" id="hd-title">파티클 모니터링 · {first.title}</span>
      <span class="hd-time" id="hd-time">--:--:--</span>
    </div>
    <div class="hd-tabs" role="tablist" aria-label="업종">
      {presets.map((p, i) => (
        <button type="button" role="tab" data-preset={i} aria-selected={i === 0}>{p.label}</button>
      ))}
    </div>
    <div class="hd-cols" aria-hidden="true"><span>구역</span><span>추세</span><span>입자 수 (개/m³, 1분 누적)</span><span>상태</span></div>
    <ul class="hd-list" id="hd-list">
      {first.zones.map((z, i) => (
        <li class="ok" style={`animation-delay:${i * 90}ms`}>
          <span class="hd-dot"></span>
          <span class="hd-name">{z.zone}<small>{z.dev} · {z.cls}</small></span>
          <svg class="hd-spark" viewBox="0 0 100 28" preserveAspectRatio="none"><path d="" /></svg>
          {z.vals.map(([label, v]) => (
            <span class="hd-val"><b>{fmt(v as number)}</b><small>{label}</small></span>
          ))}
          <span class="hd-grade">{LABEL.ok}</span>
          <span class="hd-note" hidden></span>
        </li>
      ))}
    </ul>
    <div class="hd-foot">
      <span>구성 예시 화면 · ISO 14644-1 / Annex 1 한계 대비</span>
      <span>유량 28.3 L/min · 1분 누적</span>
    </div>
  </div>
  <p class="hd-cta">이런 모니터링이 필요하다면 <a href="/labco/">랩코 장비 보기 →</a></p>
</div>

<script define:vars={{ PRESETS: presets }}>
  const LABEL = { ok: '정상', warn: '주의', alarm: '경보' };
  const list = document.getElementById('hd-list');
  const titleEl = document.getElementById('hd-title');
  const timeEl = document.getElementById('hd-time');
  const fmt = (n) => n.toLocaleString('ko-KR');
  let rows = [], preset = PRESETS[0], evt = null;

  function render(p) {
    preset = p; evt = null;
    titleEl.textContent = `파티클 모니터링 · ${p.title}`;
    list.innerHTML = p.zones.map((z, i) => `
      <li class="ok" style="animation-delay:${i * 90}ms">
        <span class="hd-dot"></span>
        <span class="hd-name">${z.zone}<small>${z.dev} · ${z.cls}</small></span>
        <svg class="hd-spark" viewBox="0 0 100 28" preserveAspectRatio="none"><path d=""></path></svg>
        ${z.vals.map(([label, v]) => `<span class="hd-val"><b>${fmt(v)}</b><small>${label}</small></span>`).join('')}
        <span class="hd-grade">정상</span>
        <span class="hd-note" hidden></span>
      </li>`).join('');
    rows = [...list.querySelectorAll('li')].map((li, i) => {
      const z = p.zones[i];
      const r = { li, base: z.vals.map(([, v, lim]) => [v, lim]), cur: z.vals.map(([, v]) => v), mult: 1, hist: [],
        els: [...li.querySelectorAll('.hd-val b')], path: li.querySelector('path'), pill: li.querySelector('.hd-grade'), note: li.querySelector('.hd-note') };
      for (let k = 0; k < 24; k++) r.hist.push(r.base[0][0] * (0.94 + Math.random() * 0.12));
      drawSpark(r); return r;
    });
  }
  function drawSpark(r) {
    const max = Math.max(...r.hist), min = Math.min(...r.hist);
    const y = (v) => 26 - ((v - min) / (max - min || 1)) * 22;
    r.path.setAttribute('d', r.hist.map((v, i) => `${i ? 'L' : 'M'}${(i / 23) * 100} ${y(v).toFixed(1)}`).join(' '));
  }
  function status(r) { const k = Math.max(...r.base.map(([, lim], i) => (lim ? r.cur[i] / lim : 0))); return k >= 1 ? 'alarm' : k >= 0.7 ? 'warn' : 'ok'; }
  function clock() { const d = new Date(); timeEl.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()].map((n) => String(n).padStart(2, '0')).join(':'); }
  function setNote(r, text) { r.note.textContent = text; r.note.hidden = !text; }

  // 이벤트 연출: 지정 구역에서 값이 올라 "주의" → 알람 → 회복. 한 사이클 약 12초, 20초마다 반복.
  // 이벤트 연출: 지정 구역에서 값이 한계의 86% 까지 올라 "주의" → 알람 → 회복. 한 사이클 약 12초, 20초마다 반복.
  // 상승폭은 업종마다 한계 대비 비율이 달라서 구역별로 계산한다 (경보까지는 가지 않게).
  function runEvent() {
    const r = rows[preset.event]; if (!r) return;
    const ratio = Math.max(...r.base.map(([v, lim]) => (lim ? v / lim : 0)));
    const target = 0.86 / ratio;
    const story = [
      [0, 1 + (target - 1) * 0.8, '작업자 출입 감지 · 입자 급증'],
      [2.2, target, '주의 알람 발송 · 담당자 확인'],
      [5.5, 1 + (target - 1) * 0.4, '회복 중 · 기류 정상'],
      [9, 1, '정상 복귀 · 회복 2분 40초'],
      [12, 1, ''],
    ];
    evt = { r };
    for (const [at, mult, text] of story) setTimeout(() => { if (evt?.r !== r) return; r.mult = mult; setNote(r, text); tick(); }, at * 1000);
  }

  function tick() {
    for (const r of rows) {
      const peak = Math.random() < 0.05 ? 1 + Math.random() * 0.2 : 1;
      r.cur = r.base.map(([v]) => (v === 0 ? (Math.random() < 0.08 ? 1 : 0) : Math.max(0, Math.round(v * r.mult * (0.95 + Math.random() * 0.1) * peak))));
      r.hist.push(r.cur[0]); r.hist.shift();
      r.cur.forEach((v, i) => (r.els[i].textContent = fmt(v)));
      const s = status(r); r.li.className = s; r.pill.textContent = LABEL[s];
      drawSpark(r);
    }
  }

  document.querySelectorAll('.hd-tabs button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.hd-tabs button').forEach((x) => x.setAttribute('aria-selected', x === b));
    render(PRESETS[Number(b.dataset.preset)]);
  }));

  render(PRESETS[0]); clock();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(tick, 2000); setInterval(clock, 1000);
    setTimeout(runEvent, 4000); setInterval(runEvent, 20000);
  }
</script>

<style is:global>
  .hd-wrap { width: 100%; max-width: 560px; }
  .hd {
    --c-ok: #3ddc97; --c-warn: #f6c35c; --c-alarm: #ff6b6b;
    width: 100%; color: #e8eef7; font-size: 0.85rem; font-family: var(--font);
    background: linear-gradient(160deg, #132339 0%, #0b1626 100%);
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px; padding: 14px 16px 12px;
    box-shadow: 0 30px 50px -24px rgba(8, 30, 60, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    font-variant-numeric: tabular-nums;
  }
  .hd-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .hd-live { display: inline-flex; align-items: center; gap: 5px; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; color: #7fd1ff; }
  .hd-live i { width: 7px; height: 7px; border-radius: 50%; background: #3b9cff; animation: pulse 1.8s infinite; }
  .hd-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hd-time { margin-left: auto; color: #8fa3bd; font-family: var(--mono); font-size: 0.78rem; }
  .hd-tabs { display: flex; gap: 4px; margin-bottom: 10px; }
  .hd-tabs button { background: rgba(255, 255, 255, 0.05); color: #a9b7c9; font-size: 0.74rem; font-weight: 600; padding: 5px 10px; border-radius: 999px; }
  .hd-tabs button:hover { filter: none; background: rgba(255, 255, 255, 0.1); color: #fff; }
  .hd-tabs button[aria-selected="true"] { background: #3b9cff; color: #fff; }
  .hd-cols, .hd-list li { display: grid; grid-template-columns: 10px minmax(0, 1fr) 44px 76px 70px 60px 44px; align-items: center; gap: 9px; }
  .hd-cols { padding: 0 10px 6px; font-size: 0.66rem; color: #6d819c; letter-spacing: 0.06em; }
  .hd-cols span:nth-child(2) { grid-column: 3; }
  .hd-cols span:nth-child(3) { grid-column: 4 / 7; text-align: right; }
  .hd-cols span:nth-child(4) { grid-column: 7; text-align: right; }
  .hd-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hd-list li { padding: 7px 10px; border-radius: 10px; background: rgba(255, 255, 255, 0.04); animation: rise 0.6s both; transition: background 0.4s; }
  .hd-list li.ok { --c: var(--c-ok); } .hd-list li.warn { --c: var(--c-warn); background: rgba(246, 195, 92, 0.08); } .hd-list li.alarm { --c: var(--c-alarm); background: rgba(255, 107, 107, 0.12); }
  .hd-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 10px var(--c); transition: background 0.4s; }
  .hd-name { font-weight: 600; line-height: 1.2; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.82rem; }
  .hd-name small { display: block; font-weight: 400; color: #8fa3bd; font-size: 0.66rem; font-family: var(--mono); }
  .hd-spark { width: 44px; height: 24px; }
  .hd-spark path { fill: none; stroke: var(--c); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; opacity: 0.9; transition: stroke 0.4s; }
  .hd-val { text-align: right; line-height: 1.1; }
  .hd-val b { font-family: var(--mono); font-size: 0.84rem; font-weight: 600; }
  .hd-val small { display: block; color: #8fa3bd; font-size: 0.6rem; }
  .hd-grade { justify-self: end; font-size: 0.66rem; font-weight: 700; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); border-radius: 999px; padding: 3px 7px; transition: color 0.4s, background 0.4s; }
  .hd-note { grid-column: 2 / 8; font-size: 0.7rem; color: var(--c); padding-top: 2px; animation: rise 0.4s both; }
  .hd-note::before { content: '▸ '; }
  .hd-foot { display: flex; justify-content: space-between; gap: 10px; color: #8fa3bd; font-size: 0.72rem; margin-top: 10px; flex-wrap: wrap; }
  .hd-cta { margin: 12px 4px 0; font-size: 0.9rem; color: var(--muted); }
  .hd-cta a { font-weight: 600; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(59, 156, 255, 0.6); } 70% { box-shadow: 0 0 0 7px rgba(59, 156, 255, 0); } 100% { box-shadow: 0 0 0 0 rgba(59, 156, 255, 0); } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (max-width: 520px) {
    .hd-cols, .hd-list li { grid-template-columns: 10px minmax(0, 1fr) 86px 46px; gap: 8px; }
    .hd-spark, .hd-cols span:nth-child(2), .hd-val + .hd-val { display: none; }
    .hd-cols span:nth-child(3) { grid-column: 3; } .hd-cols span:nth-child(4) { grid-column: 4; }
    .hd-note { grid-column: 2 / 5; }
    .hd-title { font-size: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hd-list li, .hd-live i, .hd-note { animation: none; } }
</style>
