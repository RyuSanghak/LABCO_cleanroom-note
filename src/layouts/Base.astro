---
import '../styles/global.css';
import { SITE, NAV } from '../site';

interface Props {
  title: string;
  description?: string;
  /** og:type. 글 페이지는 'article'. */
  type?: 'website' | 'article';
  /** 검색 색인 제외 (정책 페이지 등은 보통 포함해도 무방). */
  noindex?: boolean;
  /** JSON-LD 구조화 데이터 (선택). */
  jsonLd?: Record<string, unknown>;
}

const { title, description = SITE.description, type = 'website', noindex = false, jsonLd } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const adsClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={new URL('/img/cleanroom-wide.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {adsClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsClient}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="mark" aria-hidden="true"><i></i></span><span>{SITE.name}<small>{SITE.tagline}</small></span></a>
        <nav class="nav" aria-label="주 메뉴">
          {NAV.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.name} · 계산 결과와 정보는 참고용입니다.</span>
        <span>
          <a href="/about/">소개</a> · <a href="/privacy/">개인정보처리방침</a> · <a href="/labco/">랩코 제품</a>
        </span>
      </div>
    </footer>
  </body>
</html>
