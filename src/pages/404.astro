---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없음" description="요청한 페이지가 없습니다." noindex>
  <section class="nf">
    <p class="nf-code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="muted">주소가 바뀌었거나 삭제된 페이지입니다.</p>
    <div class="hero-actions">
      <a class="btn" href="/">메인으로</a>
      <a class="btn ghost" href="/tools/">계산기</a>
      <a class="btn ghost" href="/map/">미세먼지 지도</a>
    </div>
  </section>
  <style>
    .nf { padding: 48px 0 24px; max-width: 520px; }
    .nf-code { font-family: var(--mono); font-size: 3rem; font-weight: 600; color: var(--accent); margin: 0 0 4px; line-height: 1; }
  </style>
</Base>
