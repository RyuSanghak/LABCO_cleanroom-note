# 복사해서 .env 로 저장 (.env 는 git 에 올라가지 않는다)

# 애드센스 클라이언트 ID (ca-pub-...). 비우면 광고 코드가 출력되지 않는다.
PUBLIC_ADSENSE_CLIENT=

# 에어코리아 공공 API 인증키 (data.go.kr, URL 인코딩된 키 그대로). 수집 스크립트(scripts/fetch-airkorea.mjs)가 쓴다.
# GitHub Actions 에서는 저장소 Secrets 의 AIRKOREA_KEY 를 쓴다.
AIRKOREA_KEY=

# 랩코 측정망 앱 서버 주소 (…/api/devices). GitHub Actions 에서는 Secrets 의 LABCO_API_URL. 비우면 랩코 데이터 생략.
LABCO_API_URL=

# 지도가 읽을 데이터 파일 주소. 비우면 /data/airkorea.json (로컬 수집 결과).
# 배포: https://raw.githubusercontent.com/RyuSanghak/LABCO_cleanroom-note/data/airkorea/airkorea.json
PUBLIC_AIRKOREA_DATA_URL=

# 배포 주소 (sitemap, canonical). Cloudflare Pages 환경 변수에도 같은 값.
SITE_URL=https://labco-cleanroom-note.pages.dev
